NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://claims:claims@localhost:5432/claims
REDIS_URL=redis://localhost:6379
JWT_SECRET=local-development-secret-change-me-please-0123456789
S3_BUCKET=claims-photos-local
S3_ENDPOINT=http://localhost:4566
# Set to http://<your-LAN-IP>:4566 when testing photo uploads from a physical phone.
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
AWS_REGION=af-south-1
PUSH_ENABLED=true
